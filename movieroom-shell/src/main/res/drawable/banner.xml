<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#070407" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/taylormade_movies_cover"
            android:gravity="fill" />
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#d9070407"
                android:endColor="#00070407" />
        </shape>
    </item>
</layer-list>
