{
  "name": "movie-downloads",
  "version": "1.0.0",
  "description": "Simple browser-based movie streaming app for a shared personal library",
  "main": "server.js",
  "scripts": {
    "posters": "node scripts/fetch-posters.mjs",
    "artwork:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.jellyfin.local scripts/sync-jellyfin-artwork.mjs",
    "library:normalize": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/normalize-movie-library.ps1 -Apply -FolderizeMovies -OrganizeSeries",
    "metadata:sync": "node scripts/sync-jellyfin-metadata.mjs",
    "metadata:export:onedrive": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.jellyfin.local scripts/export-movie-metadata-to-onedrive.mjs",
    "metadata:watch": "node scripts/sync-jellyfin-metadata.mjs --watch",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.jellyfin.local server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylormade02471/Movie-Downloads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
